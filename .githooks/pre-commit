#!/usr/bin/env bash
# Blocks commits that contain secrets or unformatted Terraform.
# Enable once per clone: git config core.hooksPath .githooks
set -euo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed; refusing to commit without a secret scan." >&2
  exit 1
fi
gitleaks git --pre-commit --staged --redact --no-banner

if git diff --cached --name-only --diff-filter=ACM | grep -q '\.tf$'; then
  terraform fmt -check -recursive
fi

if git diff --cached --name-only --diff-filter=ACM | grep -q '\.hcl$'; then
  terragrunt hcl fmt --check --working-dir live
fi
